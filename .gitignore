# ==============================================================================
# AI Industry News Daily — .gitignore
# Full-stack Python (FastAPI/ADK/MCP) + Node.js (Vite/React) + Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
credentials.json
client_secrets.json

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
# Bytecode & compile artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (root and subdirectories)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
*/venv/
*/.venv/

# Packaging & distribution builds
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, coverage & linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter / Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend (React / Vite)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
*/node_modules/

# Production & bundle outputs
dist/
dist-ssr/
*/dist/
*/dist-ssr/

# Vite runtime cache
.vite/
*/.vite/

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Framework & linter cache
.eslintcache
.stylelintcache
*.local

# ------------------------------------------------------------------------------
# 4. Databases, Local Storage & Docker Volumes
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
dump.rdb
pgdata/
postgres_data/
data/postgres/
data/searxng/

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Runtime Files
# ------------------------------------------------------------------------------
*.log
logs/
run/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Operating System
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux temporary files
*~
*.swp
*.swo
.fuse_hidden*

# VS Code & JetBrains
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 7. Agentic & Scratch Directories
# ------------------------------------------------------------------------------
scratch/
*/scratch/
.claude/
.gemini/
