# Database
POSTGRES_USER=ainews
POSTGRES_PASSWORD=ainews_secret
POSTGRES_DB=ainews
DATABASE_URL=postgresql+asyncpg://ainews:ainews_secret@127.0.0.1:5432/ainews
SYNC_DATABASE_URL=postgresql://ainews:ainews_secret@127.0.0.1:5432/ainews

# External Services
SEARXNG_URL=http://127.0.0.1:8080
FIRECRAWL_URL=http://127.0.0.1:3002

# Security
EDITORIAL_SECRET_KEY=hermes_editorial_secret_token_change_in_production
ADMIN_API_TOKEN=admin_editorial_secret_token_change_in_production

# Editorial Defaults
DISCOVERY_LOOKBACK_HOURS=28
EDITORIAL_LOOKBACK_DAYS=28
FEEDBACK_COLD_START_DAYS=30
FEEDBACK_COLD_START_THRESHOLD=100
MIN_STORIES_PER_EDITION=5
TARGET_STORIES_PER_EDITION=8

# LLM & Agent Execution
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=deepseek/deepseek-v4-flash-0731
